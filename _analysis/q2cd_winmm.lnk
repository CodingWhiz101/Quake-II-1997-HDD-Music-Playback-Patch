system nt_dll
option quiet
option eliminate
option osversion=4.0
option caseexact
export mciSendCommandA='_mciSendCommandA@16'
export mciSendStringA='_mciSendStringA@16'
export mciGetErrorStringA='_mciGetErrorStringA@12'
export timeGetTime='_timeGetTime@0'
export timeBeginPeriod='_timeBeginPeriod@4'
export timeEndPeriod='_timeEndPeriod@4'
export waveOutOpen='_waveOutOpen@24'
export waveOutClose='_waveOutClose@4'
export waveOutReset='_waveOutReset@4'
export waveOutPrepareHeader='_waveOutPrepareHeader@12'
export waveOutUnprepareHeader='_waveOutUnprepareHeader@12'
export waveOutWrite='_waveOutWrite@12'
export joyGetNumDevs='_joyGetNumDevs@0'
export joyGetDevCapsA='_joyGetDevCapsA@12'
export joyGetPosEx='_joyGetPosEx@8'
export auxGetNumDevs='_auxGetNumDevs@0'
export auxGetDevCapsA='_auxGetDevCapsA@12'
export auxGetVolume='_auxGetVolume@8'
export auxSetVolume='_auxSetVolume@8'
